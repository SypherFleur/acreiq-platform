# Copy to backend/.env locally. Never put these credentials in frontend variables.
# Choose the Gemini Developer API (GEMINI_API_KEY takes precedence):
# PLACEHOLDER: Add your real key locally, never a literal placeholder token.
# Get a key: https://aistudio.google.com/apikey
# Leave blank for working sample/manual mode. Do not send credentials in chat.
GEMINI_API_KEY=
# Optional alias; do not fill both key variables.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional Live walkthrough; independent of the still-photo model above.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_TIMEOUT_SECONDS=30

# Or explicitly enable Vertex with application default credentials (ADC).
# gcloud auth application-default login
# A gcloud CLI login/project alone is not ADC. The Vertex API and permissions
# must already be enabled on a project you control. No setup is performed by API.
GOOGLE_GENAI_USE_VERTEXAI=false
# OPTIONAL PLACEHOLDER: Only needed when the Vertex flag above is true.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/authorized-adc.json

# Exact development origins; comma-separated. No wildcard/credentials allowed.
ACREIQ_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Server-only. Do NOT prefix model keys or this variable with NEXT_PUBLIC_.
ACREIQ_BACKEND_URL=http://127.0.0.1:8000

# Separate browser-public Google Maps JavaScript API key, never a Gemini key.
# Restrict by website/referrer and allowed APIs: Maps JavaScript API plus
# Geocoding API for address search. API/billing
# configuration needs the account owner's approval. Rebuild after changing this.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
